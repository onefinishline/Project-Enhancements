# Copy to .env and fill in. .env is git-ignored.
PORT=3100
# Network address the app listens on. Default 127.0.0.1 (this machine only; nginx in front). Leave unset.
# HOST=127.0.0.1
# PostgreSQL connection (required). Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://enhancements:CHANGE_ME@localhost:5432/project_enhancements
# Set PGSSL=true if the database server requires an encrypted connection.
# PGSSL=true
# Public address of the site, used in emailed links (required in production)
APP_URL=http://localhost:3100
# Only addresses at this domain can create accounts
ALLOWED_EMAIL_DOMAIN=sil.org
# NODE_ENV=production

# Outgoing email for account confirmation and password reset links (same settings as RecruitFlow).
# Without SMTP_HOST (outside production) emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
